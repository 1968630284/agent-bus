{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/1968630284/agent-bus/blob/main/schema/board-message.schema.json",
  "title": "Agent Bus message",
  "description": "One line of board.jsonl. Consumers must tolerate unknown fields (forward compatible).",
  "type": "object",
  "required": ["ts", "from", "to", "kind", "text", "id"],
  "properties": {
    "ts": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
      "description": "Local time, used for display and sorting; not required to be monotonic"
    },
    "from": { "type": "string", "minLength": 1, "description": "Speaker identity" },
    "to": { "type": "string", "minLength": 1, "description": "Recipient, defaults to all" },
    "kind": {
      "type": "string",
      "minLength": 1,
      "examples": ["note", "status", "task", "question", "decision", "result", "discuss", "verdict"]
    },
    "text": { "type": "string", "description": "Body; keep it single-line" },
    "ref": { "type": "string", "description": "Order number, file name or previous id; empty when unused" },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}$", "description": "8 hex chars, unique within the process" }
  },
  "additionalProperties": true
}
